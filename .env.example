DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
# Automations (see README "Automations")
APP_URL="http://localhost:3000"
AUTOMATION_SECRET="replace-with-a-random-string-of-24-or-more-characters"
# log = print emails (development). hold = keep them queued until a
# HIPAA-eligible email provider with a signed BAA is connected.
EMAIL_TRANSPORT="log"
# Amazon SES (EMAIL_TRANSPORT="ses"), only after the AWS BAA is accepted:
EMAIL_FROM="FindYourDoc <no-reply@findyourdoc.com>"
AWS_REGION="us-east-1"
SES_CONFIGURATION_SET=""
