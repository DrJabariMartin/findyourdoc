DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
STORAGE_DIR="./storage"
# Automations (see README "Automations")
APP_URL="http://localhost:3000"
AUTOMATION_SECRET="replace-with-a-random-string-of-24-or-more-characters"
# Email: log = print emails (development). hold = keep them queued (production
# default). ses = Amazon SES, only after the AWS BAA is accepted.
EMAIL_TRANSPORT="log"
EMAIL_FROM="FindYourDoc <no-reply@findyourdoc.com>"
AWS_REGION="us-east-1"
SES_CONFIGURATION_SET=""
# Founding-practice deposit ($99, refundable). Leave off until counsel signs
# off on pricing; then set both, using a Stripe Payment Link.
DEPOSITS_ENABLED="false"
FOUNDING_DEPOSIT_URL=""

# States where practices may post locums, comma separated. Leave unset in development.
# In production keep it empty until counsel confirms a staffing-agency license is not needed,
# or the license is in hand (Maryland OHCQ health care staff agency, DC nurse staffing agency).
# LOCUMS_STATES=""
