DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
STORAGE_DIR="./storage"
# Automations (see README "Automations")
APP_URL="http://localhost:3000"
AUTOMATION_SECRET="replace-with-a-random-string-of-24-or-more-characters"
# Email: log = print emails (development). hold = keep them queued (production
# default). ses = Amazon SES, only after the AWS BAA is accepted.
EMAIL_TRANSPORT="log"
EMAIL_FROM="FindYourDoc <no-reply@findyourdoc.com>"
AWS_REGION="us-east-1"
SES_CONFIGURATION_SET=""
# AI Opener (Instagram and Facebook DMs and comments). See README "AI Opener".
# off = do nothing, draft = email Dr. Martin each proposed reply, send = reply automatically.
OPENER_MODE="off"
OPENER_NOTIFY_EMAIL=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_PAGE_TOKEN=""
META_GRAPH_VERSION="v21.0"
ANTHROPIC_API_KEY=""
OPENER_MODEL="claude-sonnet-5-5"
OPENER_BOOKING_LINK=""
OPENER_CALENDAR_LINK=""
OPENER_LINK_RATE=""
OPENER_LINK_CONTRACT=""
OPENER_LINK_HIRE=""
OPENER_LINK_CREDENTIAL=""
